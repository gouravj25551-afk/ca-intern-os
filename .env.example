# =============================================================================
# CA Intern OS — Environment Variables
# Copy this file to `.env` (local) and set real values.
# NEVER commit `.env` with real secrets. Configure these in Vercel for prod.
# =============================================================================

# ---- Database (PostgreSQL) --------------------------------------------------
# Local example (see README for `npm run db:local`):
#   postgresql://ca:ca@localhost:5432/ca_intern_os?schema=public
# Production (Vercel Postgres / Neon / Supabase): use the pooled connection URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ca_intern_os?schema=public"

# Optional: a direct (non-pooled) connection used by `prisma migrate`.
# On Vercel Postgres / Neon set this to the direct/unpooled URL. If unset,
# DATABASE_URL is used.
DIRECT_URL=""

# ---- Authentication ---------------------------------------------------------
# A long random secret used to sign session JWTs.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"

# Session lifetime in seconds (default 8 hours).
SESSION_MAX_AGE="28800"

# ---- First admin bootstrap (optional) ---------------------------------------
# Used by `npm run setup:admin` and the one-time /setup page fallback.
# You can also create the first admin interactively via the /setup page.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeThisStrongPassword123!"
ADMIN_NAME="Administrator"

# ---- App --------------------------------------------------------------------
# Public base URL of the deployment (used for metadata). Optional.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
